# Copy to .env and adjust. docker-compose reads .env automatically.

# --- InfluxDB ---
INFLUX_USERNAME=admin
INFLUX_PASSWORD=changeme-influx
INFLUX_ORG=forza
INFLUX_BUCKET=telemetry
# Admin/all-access token shared by InfluxDB, Telegraf, and Grafana. Use a long random string.
INFLUX_TOKEN=changeme-supersecret-token
# 0s = keep forever. Or e.g. 720h for 30 days.
INFLUX_RETENTION=0s
INFLUX_PORT=8086

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana
GRAFANA_PORT=3000

# --- Forza UDP intake ---
FORZA_UDP_PORT=5300
