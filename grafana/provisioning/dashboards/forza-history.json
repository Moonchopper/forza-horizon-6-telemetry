{
  "uid": "forza-history",
  "title": "Forza History (sessions)",
  "tags": ["forza", "history"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      { "name": "bucket", "type": "constant", "label": "Bucket", "query": "telemetry", "current": { "text": "telemetry", "value": "telemetry" }, "hide": 2 }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Engine RPM",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-forza" },
      "targets": [
        { "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-forza" }, "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"current_engine_rpm\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)" }
      ],
      "fieldConfig": { "defaults": { "unit": "rotrpm", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Speed (m/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-forza" },
      "targets": [
        { "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-forza" }, "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"speed\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)" }
      ],
      "fieldConfig": { "defaults": { "unit": "velocityms", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throttle / Brake (0-255)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb-forza" },
      "targets": [
        { "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-forza" }, "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"accel\" or r._field == \"brake\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 255, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" } },
        "overrides": [ { "matcher": { "id": "byName", "options": "brake" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }, { "matcher": { "id": "byName", "options": "accel" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tire temps (FL/FR/RL/RR)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb-forza" },
      "targets": [
        { "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-forza" }, "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"tire_temp_fl\" or r._field == \"tire_temp_fr\" or r._field == \"tire_temp_rl\" or r._field == \"tire_temp_rr\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)" }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "xychart",
      "title": "Track map (position X/Z)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "influxdb-forza" },
      "targets": [
        { "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-forza" }, "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"position_x\" or r._field == \"position_z\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")" }
      ],
      "fieldConfig": { "defaults": { "custom": { "show": "points", "pointSize": { "fixed": 3 } } }, "overrides": [] },
      "options": { "mapping": "manual", "series": [ { "x": { "matcher": { "id": "byName", "options": "position_x" } }, "y": { "matcher": { "id": "byName", "options": "position_z" } } } ] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lap times (best / last / current)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "influxdb-forza" },
      "targets": [
        { "refId": "A", "datasource": { "type": "influxdb", "uid": "influxdb-forza" }, "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"best_lap\" or r._field == \"last_lap\" or r._field == \"current_lap\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
