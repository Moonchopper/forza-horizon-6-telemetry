{
  "uid": "forza-driver-live",
  "title": "Forza Driver (Live)",
  "tags": [
    "forza",
    "analysis",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1s",
  "liveNow": true,
  "time": {
    "from": "now-2m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Race START",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-forza"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "target": {
          "queryType": "flux",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\" and r._field == \"is_race_on\")\n  |> aggregateWindow(every: 1s, fn: last, createEmpty: false)\n  |> difference()\n  |> filter(fn: (r) => r._value > 0)\n  |> map(fn: (r) => ({ _time: r._time, text: \"Race START\" }))"
        }
      },
      {
        "name": "Race STOP",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-forza"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "queryType": "flux",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\" and r._field == \"is_race_on\")\n  |> aggregateWindow(every: 1s, fn: last, createEmpty: false)\n  |> difference()\n  |> filter(fn: (r) => r._value < 0)\n  |> map(fn: (r) => ({ _time: r._time, text: \"Race STOP\" }))"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "type": "constant",
        "label": "Bucket",
        "query": "telemetry",
        "current": {
          "text": "telemetry",
          "value": "telemetry"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "xychart",
      "title": "Friction circle (G-G diagram)  -  live",
      "description": "Live rolling buffer pushed over WebSocket. Each point is a moment; the cloud radius is grip used. Buffer length = Max data points.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-forza"
      },
      "maxDataPoints": 800,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-forza"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"lateral_g\" or r._field == \"longitudinal_g\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": -2,
          "max": 2,
          "decimals": 2,
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 3
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lateral_g"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Lateral G"
              },
              {
                "id": "displayName",
                "value": "Lateral G"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "longitudinal_g"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Longitudinal G"
              },
              {
                "id": "displayName",
                "value": "Longitudinal G"
              }
            ]
          }
        ]
      },
      "options": {
        "seriesMapping": "manual",
        "series": [
          {
            "x": "lateral_g",
            "y": "longitudinal_g"
          }
        ],
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current G",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "datasource",
            "uid": "grafana"
          },
          "queryType": "measurements",
          "channel": "stream/forza/forza",
          "filter": {
            "fields": [
              "lateral_g",
              "longitudinal_g"
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 1.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "xychart",
      "title": "Dyno  -  power (hp) & torque (Nm) vs RPM  -  live",
      "description": "Live rolling buffer. Run the rev range to draw the curves.",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-forza"
      },
      "maxDataPoints": 800,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-forza"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\")\n  |> filter(fn: (r) => r._field == \"current_engine_rpm\" or r._field == \"power_hp\" or r._field == \"torque\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 3
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "power_hp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "Power (hp)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "torque"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "displayName",
                "value": "Torque (Nm)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "current_engine_rpm"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "RPM"
              }
            ]
          }
        ]
      },
      "options": {
        "seriesMapping": "manual",
        "series": [
          {
            "x": "current_engine_rpm",
            "y": "power_hp",
            "name": "Power (hp)"
          },
          {
            "x": "current_engine_rpm",
            "y": "torque",
            "name": "Torque (Nm)"
          }
        ],
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
