{
  "uid": "forza-live",
  "title": "Forza Cockpit (Live)",
  "tags": [
    "forza",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "1s",
  "time": {
    "from": "now-2m",
    "to": "now"
  },
  "liveNow": true,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Race START",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-forza"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "target": {
          "queryType": "flux",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\" and r._field == \"is_race_on\")\n  |> aggregateWindow(every: 1s, fn: last, createEmpty: false)\n  |> difference()\n  |> filter(fn: (r) => r._value > 0)\n  |> map(fn: (r) => ({ _time: r._time, text: \"Race START\" }))"
        }
      },
      {
        "name": "Race STOP",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-forza"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "target": {
          "queryType": "flux",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"forza\" and r._field == \"is_race_on\")\n  |> aggregateWindow(every: 1s, fn: last, createEmpty: false)\n  |> difference()\n  |> filter(fn: (r) => r._value < 0)\n  |> map(fn: (r) => ({ _time: r._time, text: \"Race STOP\" }))"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "type": "constant",
        "label": "Bucket",
        "query": "telemetry",
        "current": {
          "text": "telemetry",
          "value": "telemetry"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Engine RPM",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "datasource",
            "uid": "grafana"
          },
          "queryType": "measurements",
          "channel": "stream/forza/forza",
          "filter": {
            "fields": [
              "current_engine_rpm"
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "min": 0,
          "max": 8000,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 6000
              },
              {
                "color": "red",
                "value": 7000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/current_engine_rpm/",
          "values": false
        }
      }
    },
